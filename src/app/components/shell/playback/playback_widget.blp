using Gtk 4.0;
using Adw 1;

template $PlaybackWidget : Box {
  orientation: vertical;

  Overlay seek_overlay {
    overflow: visible;

    [overlay]
    Scale seek_bar {
      show-fill-level: true;
      restrict-to-fill-level: false;
      fill-level: 0;
      digits: 0;
      draw-value: false;

      styles [
        "seek-bar",
      ]
    }

    child: Box {
      can-target: false;
      valign: start;

      Label track_position {
        label: "0∶00";
        halign: start;
        visible: false;
        hexpand: true;

        styles [
          "numeric",
          "seek-time-label",
        ]
      }

      Label track_duration {
        label: "0∶00";
        halign: end;
        visible: false;

        styles [
          "numeric",
          "seek-time-label",
        ]
      }
    };
  }

  Adw.BreakpointBin {
    width-request: 1;
    height-request: 75;
    margin-top: 4;

    Adw.Breakpoint {
      condition("max-width:764sp")

      setters {
        now_playing_box.visible: false;
        now_playing_button_box.visible: true;
        volume_box.visible: false;
        volume_button.visible: true;
        queue_button.visible: false;
        device_selector.visible: false;
        playback_center.margin-start: 16;
        playback_center.margin-end: 16;
        playback_center.homogeneous: false;
      }
    }

    child: Box playback_center {
      orientation: horizontal;
      homogeneous: true;
      halign: fill;
      hexpand: true;
      height-request: 58;
      margin-top: 8;
      margin-bottom: 9;
      margin-start: 8;
      margin-end: 8;

      Box now_playing_start {
        hexpand: true;
        halign: start;
        valign: center;

        Box now_playing_button_box {
          visible: false;
          width-request: 40;
          valign: center;

          Button now_playing_button {
            visible: false;
            icon-name: "now-playing-symbolic";
            tooltip-text: _("Now Playing");
            focus-on-click: false;
            can-focus: false;
            valign: center;

            styles [
              "flat",
            ]
          }
        }

        Box now_playing_box {
          hexpand: true;
          height-request: 58;
          overflow: hidden;
          halign: start;

          $PlaybackInfoWidget now_playing {
            receives-default: "1";
            halign: "start";
            valign: "center";
            has-frame: "0";
            visible: false;
          }
        }
      }

      $PlaybackControlsWidget controls {
        hexpand: false;
        halign: center;
        valign: center;
      }

      Box {
        hexpand: true;
        halign: end;
        valign: center;

        ToggleButton queue_button {
          width-request: 40;
          margin-end: 6;
          icon-name: "queue-symbolic";
          /* Translators: Tooltip of the playback bar button that shows or hides the queue. */
          tooltip-text: _("Queue");
          action-name: "win.utility-panel";
          halign: end;
          valign: center;
          focus-on-click: false;
          can-focus: false;

          styles [
            "flat"
          ]
        }

        $DeviceSelectorWidget device_selector {
          width-request: 40;
          margin-end: 6;
          halign: end;
          valign: center;
          focus-on-click: false;
          can-focus: false;

          styles [
            "flat"
          ]
        }

        Box volume_box {
          width-request: 204;

          Box {
            hexpand: true;

            Image {
              icon-name: 'multimedia-volume-control-symbolic';
            }

            Scale volume_slider {
              hexpand: true;
              show-fill-level: true;
              restrict-to-fill-level: false;
              value-pos: left;

              styles [
                'volume-slider'
              ]

              adjustment: Adjustment {
                lower: 0.0;
                value: 0.7;
                upper: 1.0;
                step-increment: 0.01;
                page-increment: 0.05;
              };
            }
          }
        }

        MenuButton volume_button {
          visible: false;
          width-request: 40;
          icon-name: 'multimedia-volume-control-symbolic';
          tooltip-text: _("Volume");
          halign: end;
          valign: center;
          direction: up;
          focus-on-click: false;
          can-focus: false;

          styles [
            "flat"
          ]

          popover: Popover {
            child: Scale {
              inverted: true;
              orientation: vertical;
              height-request: 160;
              adjustment: bind volume_slider.adjustment;
            };
          };
        }

      }
    };
  }
}
