using Gtk 4.0;

// Developer tools menu (debug builds only). Loaded and wired up procedurally
// by src/app/dev_tools.rs, which packs `dev_menu` into the navigation panel header.
MenuButton dev_menu {
  icon-name: "preferences-other-symbolic";
  focus-on-click: false;
  can-focus: false;
  visible: false;
  tooltip-text: "Dev Tools";

  popover: Popover {
    child: Box {
      orientation: vertical;
      spacing: 6;
      margin-top: 8;
      margin-bottom: 8;
      margin-start: 8;
      margin-end: 8;

      Label {
        label: "Interface";
        styles ["heading"]
        halign: start;
      }

      Box {
        orientation: horizontal;
        spacing: 8;

        Label {
          label: "Force Skeleton";
          hexpand: true;
          halign: start;
        }

        Switch dev_skeleton_switch {}
      }

      Box {
        orientation: horizontal;
        spacing: 8;

        Label {
          label: "Debug CSS";
          hexpand: true;
          halign: start;
        }

        Switch dev_debug_css_switch {}
      }

      Box {
        orientation: horizontal;
        spacing: 8;

        Label {
          label: "Panel Sizes";
          hexpand: true;
          halign: start;
        }

        Switch dev_panel_sizes_switch {}
      }

      Button dev_test_toast {
        label: "Test Toast";
      }

      Button dev_reload_css {
        label: "Reload CSS";
      }

      Button dev_dump_state {
        label: "Dump State to Log";
      }

      Separator {}

      Label {
        label: "riff-api";
        styles ["heading"]
        halign: start;
      }

      Box {
        orientation: horizontal;
        spacing: 8;

        Label {
          label: "Simulate Offline";
          hexpand: true;
          halign: start;
        }

        Switch dev_offline_switch {}
      }

      Label {
        label: "Inject API Error";
        halign: start;
      }

      Box {
        orientation: horizontal;
        styles ["linked"]

        ToggleButton dev_error_off {
          label: "Off";
          active: true;
        }

        ToggleButton dev_error_429 {
          label: "429";
          group: dev_error_off;
        }

        ToggleButton dev_error_401 {
          label: "401";
          group: dev_error_off;
        }

        ToggleButton dev_error_500 {
          label: "500";
          group: dev_error_off;
        }

        ToggleButton dev_error_nocontent {
          label: "No Content";
          group: dev_error_off;
        }
      }

      Button dev_expire_token {
        label: "Expire OAuth Token";
      }

      Separator {}

      Label {
        label: "Librespot";
        styles ["heading"]
        halign: start;
      }

      Button dev_kill_player {
        label: "Kill Player";

        styles ["destructive-action"]
      }

      Button dev_kill_session {
        label: "Kill Session";

        styles ["destructive-action"]
      }

      Button dev_simulate_unavailable {
        label: "Simulate Unavailable Track";
      }

      Button dev_reset_drm {
        label: "Reset DRM Verification";
      }

      Button dev_show_drm_dialog {
        label: "Show DRM Warning";
      }

      Separator {}

      Label {
        label: "Soloist";
        styles ["heading"]
        halign: start;
      }

      Button dev_soloist_check_update {
        label: "Check for Update Now";
      }

      Button dev_soloist_out_of_date {
        label: "Make Build Out of Date";
      }

      Button dev_soloist_kill {
        label: "Kill Soloist";

        styles ["destructive-action"]
      }

      Box {
        orientation: horizontal;
        spacing: 8;

        Label {
          label: "Block Downloads";
          hexpand: true;
          halign: start;
        }

        Switch dev_soloist_block_switch {}
      }

      Label {
        label: "Show Toast";
        halign: start;
      }

      Box {
        orientation: horizontal;
        styles ["linked"]

        Button dev_soloist_toast_updating {
          label: "Updating";
        }

        Button dev_soloist_toast_failed {
          label: "Not Available";
        }

        Button dev_soloist_toast_expires {
          label: "Expires Soon";
        }
      }
    };
  };
}
