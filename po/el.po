#. translators: This is part of a contextual menu attached to a single track; this entry allows viewing the album containing a specific track.
#: src/app/components/labels.rs:8
msgid "View Album"
msgstr "Προβολή δίσκων"

#. translators: This is part of a contextual menu attached to a single track; the intent is to copy the link (public URL) to a specific track.
#: src/app/components/labels.rs:11
#: src/app/components/widgets/details_page/header.blp:179
msgid "Copy Link"
msgstr "Αντιγραφή συνδέσμου"

#. translators: This is part of a contextual menu attached to a single track; this entry queues the track after the tracks already queued.
#: src/app/components/labels.rs:14
#: src/app/components/widgets/selection/selection_toolbar.blp:38
msgid "Add to Queue"
msgstr "Προσθήκη στην ουρά"

#. translators: This is part of a contextual menu attached to a single track; this entry opens a list of playlists to add the track to.
#: src/app/components/labels.rs:17
#: src/app/components/widgets/selection/selection_toolbar.blp:50
msgid "Add to Playlist"
msgstr "Προσθήκη σε λίστα..."

#. translators: This is part of a contextual menu attached to a single track; this entry starts selecting tracks, with this one.
#: src/app/components/labels.rs:20
msgid "Select Track"
msgstr "Επιλογή τραγουδιού"

#. translators: This is part of a contextual menu attached to a single track; this entry removes the track from the playlist being viewed.
#: src/app/components/labels.rs:23
#: src/app/components/widgets/selection/selection_toolbar.blp:72
msgid "Remove from Playlist"
msgstr "Αφαίρεση από την λίστα"

#. translators: Name of the user's saved tracks, as the source of what's playing (e.g. "Next from: Saved Tracks").
#. translators: This is a navigation panel entry to browse to saved tracks.
#: src/app/components/labels.rs:26
#: src/app/components/shell/navigation_panel/navigation_panel_item.rs:78
msgid "Saved Tracks"
msgstr "Αποθηκευμένα τραγούδια"

#. translators: Header above the tracks the user added to the play queue, on the queue page.
#: src/app/components/labels.rs:29
msgid "Next in Queue"
msgstr "Επόμενο στην ουρά"

#. translators: Header of the current track, on the queue page (when shown in the list).
#. translators: This is a navigation panel entry to browse to saved playlists.
#: src/app/components/labels.rs:32
#: src/app/components/pages/now_playing/model.rs:71
#: src/app/components/shell/navigation_panel/navigation_panel_item.rs:80
#: src/app/components/pages/shortcuts/shortcuts.blp:79
#: src/app/components/shell/playback/playback_widget.blp:110
msgid "Now Playing"
msgstr "Τώρα παίζει"

#. translators: Tooltip of the button in the header of the queued tracks, on the queue page. It removes all queued tracks.
#: src/app/components/labels.rs:35
msgid "Clear Queue"
msgstr "Καθαρισμός ουράς"

#. translators: Notification shown after tracks were added to the play queue.
#: src/app/components/labels.rs:38
msgid "Added to queue"
msgstr "Προστέσθηκε στην ουρά"

#. translators: This is part of a contextual menu attached to a single track; this entry removes a track from the play queue.
#: src/app/components/labels.rs:41
msgid "Remove from Queue"
msgstr "Αφαίρεση απ'την ουρά"

#. translators: This is part of a contextual menu attached to a single track; this entry saves the track to the user's saved tracks.
#: src/app/components/labels.rs:44
#: src/app/components/widgets/track_list/track_row.blp:159
#: src/app/components/widgets/selection/selection_toolbar.blp:83
msgid "Add to Saved Tracks"
msgstr "Προσθήκη στα Αγαπημένα τραγούδια"

#. translators: This is part of a contextual menu attached to a single track; this entry removes the track from the user's saved tracks.
#: src/app/components/labels.rs:47
msgid "Remove from Saved Tracks"
msgstr "Αφαίρεση από τα Αποθηκευμένα τραγούδια"

#. translators: This is part of a contextual menu attached to a single track, and the tooltip of the pin button on a detail page; this entry pins the item to the sidebar.
#: src/app/components/labels.rs:50
msgid "Pin to Sidebar"
msgstr "Καρφίτσωμα στη πλευρική στήλη"

#. translators: This is part of a contextual menu attached to a single track, and the tooltip of the pin button on a detail page; this entry removes the item from the sidebar.
#: src/app/components/labels.rs:53
msgid "Unpin from Sidebar"
msgstr "Ξεκαρφίτσωμα από τη πλευρική στήλη"

#. translators: This is the tooltip for the like/star button on an album's detail page; it saves the album to the user's saved albums.
#: src/app/components/labels.rs:56
msgid "Add to Saved Albums"
msgstr "Προσθήκη στους Αποθηκευμένους δίσκους"

#. translators: This is the tooltip for the like/star button on an album's detail page; it removes the album from the user's saved albums.
#: src/app/components/labels.rs:59
msgid "Remove from Saved Albums"
msgstr "Αφαίρεση από τους Αποθηκευμένους δίσκους"

#. translators: This is the tooltip for the like/star button on an artist's detail page; it follows the artist, adding them to the user's saved artists.
#: src/app/components/labels.rs:62
msgid "Add to Saved Artists"
msgstr "Προσθήκη στους Αποθηκευμένους καλλιτέχνες"

#. translators: This is the tooltip for the like/star button on an artist's detail page; it unfollows the artist, removing them from the user's saved artists.
#: src/app/components/labels.rs:65
msgid "Remove from Saved Artists"
msgstr "Αφαίρεση από τους Αποθηκευμένους καλλιτέχνες"

#. translators: This is the tooltip for the like/star button on a playlist's detail page; it saves the playlist to the user's saved playlists.
#: src/app/components/labels.rs:68
msgid "Add to Saved Playlists"
msgstr "Προσθήκη στις Αποθηκευμένες λίστες"

#. translators: This is the tooltip for the like/star button on a playlist's detail page; it removes the playlist from the user's saved playlists.
#: src/app/components/labels.rs:71
msgid "Remove from Saved Playlists"
msgstr "Αφαίρεση από τις Αποθηκευμένες λίστες"

#. translators: This is part of a contextual menu attached to a playlist in the sidebar; this entry starts playing the playlist from the first track.
#: src/app/components/labels.rs:74
#: src/app/components/shell/playback/playback_controls.rs:71
#: src/app/components/widgets/details_page/header.rs:233
#: src/app/components/widgets/details_page/header.blp:140
msgid "Play"
msgstr "Αναπαραγωγή"

#. translators: This is part of a contextual menu attached to a playlist in the sidebar; this entry starts playing the playlist in shuffle mode.
#: src/app/components/labels.rs:77
#: src/app/components/pages/shortcuts/shortcuts.blp:50
#: src/app/components/shell/playback/playback_controls.blp:15
#: src/app/components/widgets/details_page/header.blp:153
msgid "Shuffle"
msgstr "Ανακάτεμα"

#. translators: This is part of a contextual menu attached to a playlist in the sidebar; this entry deletes a playlist owned by the user.
#: src/app/components/labels.rs:80
msgid "Delete Playlist"
msgstr "Διαγραφή λίστας"

#. translators: This is part of a contextual menu attached to a playlist in the sidebar; this entry unfollows a playlist the user does not own.
#: src/app/components/labels.rs:83
msgid "Unfollow Playlist"
msgstr "Αφαίρεση ακολούθησης λίστας"

#. translators: This is part of the menu of a playlist's page; this entry opens a dialog to edit the name, description, cover and visibility of a playlist owned by the user.
#: src/app/components/labels.rs:86
msgid "Edit Details"
msgstr "Επεξεργασία λεπτομερειών"

#. translators: This is the caption shown in the header of a playlist's detail page when anyone can open the playlist.
#: src/app/components/labels.rs:89
msgid "Public Playlist"
msgstr "Κοινή λίστα"

#. translators: This is the caption shown in the header of a playlist's detail page when nobody but its owner can open the playlist.
#: src/app/components/labels.rs:92
msgid "Private Playlist"
msgstr "Ιδιωτική λίστα"

#. translators: This is the caption shown in the header of an album's detail page when the release is a full album.
#. translators: An album in the back/forward history menu, while its name is loading.
#: src/app/components/labels.rs:95 src/app/components/labels.rs:201
#: src/app/components/pages/settings/settings.blp:193
msgid "Album"
msgstr "Δίσκος"

#. translators: This is the caption shown in the header of an album's detail page when the release is a single.
#: src/app/components/labels.rs:98
msgid "Single"
msgstr "Single"

#. translators: This is the caption shown in the header of an album's detail page when the release is an EP (extended play).
#: src/app/components/labels.rs:101
msgid "EP"
msgstr "EP"

#. translators: Shown in place of a card list when the selected filter (e.g. "EPs") matches nothing.
#. Translators: Shown in place of a card list when the selected filter (e.g. "EPs") matches nothing.
#: src/app/components/labels.rs:104
#: src/app/components/widgets/details_page/details_section.blp:39
msgid "No items found for this filter"
msgstr "Δεν βρέθηκαν αποτελέσματα για αυτό το φίλτρο"

#. translators: This is the caption shown in the header of an album's detail page when the release is a compilation.
#: src/app/components/labels.rs:107
msgid "Compilation"
msgstr "Συλλογή"

#. translators: This notification is shown when a track was added to a playlist; {} is the name of the playlist.
#: src/app/components/labels.rs:112
#, rust-format
msgid "Added to {}"
msgstr "Προστέθηκε στο {}"

#. translators: This notification is shown when nothing was added to a playlist, as it already lists the tracks; {} is the name of the playlist.
#: src/app/components/labels.rs:117
#, rust-format
msgid "Already in {}"
msgstr "Ήδη παρόν στο {}"

#. translators: This notification is shown when tracks were added to a playlist, except those it already lists; the first {} is the name of the playlist, the second {} is how many tracks were left out.
#: src/app/components/labels.rs:123
#, rust-format
msgid "Added to {}, skipping {} track already in it"
msgid_plural "Added to {}, skipping {} tracks already in it"
msgstr[0] "Προστέθηκε στο {}, παράλειψη {} τραγουδιού που είναι ήδη παρόν"
msgstr[1] "Προστέθηκαν στο {}, παράλειψη {} τραγουδιών που είναι ήδη παρόντα"

#. translators: This shows up when in selection mode. This text should be as short as possible.
#: src/app/components/labels.rs:132
#, rust-format
msgid "{} track selected"
msgid_plural "{} tracks selected"
msgstr[0] "{} επιλεγμένο τραγούδι"
msgstr[1] "{} επιλεγμένα τραγούδια"

#. translators: Shown from time to time in the bar at the bottom of the window that opens the queue. It's Pango markup: keep the tags, around the same words. The first {} is the title of the track playing, the second its artist.
#: src/app/components/labels.rs:156
#, rust-format
msgid ""
"<span size=\"small\" weight=\"light\">Now Playing</span> <b>{}</b> <span "
"size=\"small\" weight=\"light\">by</span> {}"
msgstr ""
"<span size=\"small\" weight=\"light\">Τώρα παίζει</span> <b>{}</b> <span "
"size=\"small\" weight=\"light\">από</span> {}"

#. translators: Shown from time to time in the bar at the bottom of the window that opens the queue, while playback is paused. It's Pango markup: keep the tags, around the same words. The first {} is the title of the current track, the second its artist.
#: src/app/components/labels.rs:162
#, rust-format
msgid ""
"<span size=\"small\" weight=\"light\">Current Track</span> <b>{}</b> <span "
"size=\"small\" weight=\"light\">by</span> {}"
msgstr ""
"<span size=\"small\" weight=\"light\">Τρέχων τραγούδι</span> <b>{}</b> <span "
"size=\"small\" weight=\"light\">από</span> {}"

#. translators: Shown from time to time in the bar at the bottom of the window that opens the queue. It's Pango markup: keep the tags, around the same words. The first {} is the title of the track playing next, the second its artist.
#: src/app/components/labels.rs:168
#, rust-format
msgid ""
"<span size=\"small\" weight=\"light\">Up Next</span> <b>{}</b> <span "
"size=\"small\" weight=\"light\">by</span> {}"
msgstr ""
"<span size=\"small\" weight=\"light\">Αμέσως μετά</span> <b>{}</b> <span "
"size=\"small\" weight=\"light\">από</span> {}"

#. translators: Header above the rest of the album, playlist or artist being played, on the queue page. {} is its name.
#: src/app/components/labels.rs:174
#, rust-format
msgid "Next from: {}"
msgstr "Περισσότερα από: {}"

#. translators: Description of the shuffle separation preference. {} is the number of other songs, chosen by the user. "When possible" because an album or playlist can have too few songs.
#: src/app/components/labels.rs:180
#, rust-format
msgid ""
"When possible, shuffle and repeat mode will play at least {} other song "
"before repeating a song"
msgid_plural ""
"When possible, shuffle and repeat mode will play at least {} other songs "
"before repeating a song"
msgstr[0] ""
"Όταν επιτρέπεται, ανακατανομή και επανάληψη θα παίξει τουλάχιστον {} άλλο "
"τραγούδι πριν την επανάληψη τραγουδιού"
msgstr[1] ""
"Όταν επιτρέπεται, ανακατανομή και επανάληψη θα παίξει τουλάχιστον {} άλλων "
"τραγουδιών πριν την επανάληψη τραγουδιού"

#. translators: This is part of a contextual menu attached to a single track; the full text is "More from <artist>".
#: src/app/components/labels.rs:189
#, rust-format
msgid "More from {}"
msgstr "Περισσότερα από {}"

#. translators: This is part of a larger label that reads "<Album> by <Artist>"
#: src/app/components/labels.rs:194
#, rust-format
msgid "{} by {}"
msgstr "{} από {}"

#. translators: An artist in the back/forward history menu, while their name is loading.
#: src/app/components/labels.rs:203
msgid "Artist"
msgstr "Καλλιτέχνης"

#. translators: A playlist in the back/forward history menu, while its name is loading.
#: src/app/components/labels.rs:205
#: src/app/components/pages/details_playlist/model.rs:154
msgid "Playlist"
msgstr "Λίστα"

#. translators: A user's page in the back/forward history menu, while their name is loading.
#: src/app/components/labels.rs:207
msgid "User"
msgstr "Χρήστης"

#. translators: The search page in the back/forward history menu.
#: src/app/components/labels.rs:209
#: src/app/components/pages/shortcuts/shortcuts.blp:64 src/window.blp:177
msgid "Search"
msgstr "Αναζήτηση"

#. translators: This notification is shown when uploading the cover of a playlist failed.
#: src/app/components/mod.rs:127
msgid "The playlist's cover could not be uploaded."
msgstr "Το ανέβασμα εικόνας στη λίστα δεν πραγματοποίηθηκε."

#. translators: This notification is shown when Spotify throttles requests.
#: src/app/components/mod.rs:228 src/connect/player.rs:256
msgid "Rate limited by Spotify. Please wait a moment and try again."
msgstr ""
"Όρια χρήσης από το Spotify. Παρακαλώ περιμένετε λίγο και ξαναπροσπαθήστε."

#. translators: This notification is the default message for unhandled errors. Logs refer to console output.
#: src/app/components/mod.rs:244
msgid "An error occured. Check logs for details!"
msgstr "Παρουσιάστηκε σφάλμα. Για πληροφορίες, ελέγξτε το αρχείο καταγραφής!"

#: src/app/components/pages/details_artist/widget.rs:33
msgid "Top Tracks"
msgstr "Δημοφιλή τραγούδια"

#: src/app/components/pages/details_artist/widget.rs:35
msgid "Releases"
msgstr "Κυκλοφορίες"

#. translators: This notification is shown when the user emptied the description of a playlist, which cannot be removed once set.
#: src/app/components/pages/details_playlist/model.rs:104
msgid "A playlist's description can't be removed, so it was kept."
msgstr ""
"Δεν ήταν δυνατή η αφαίρεση λεπτομερειών της λίστας, επομένως παρέμεινε ως "
"έχει."

#: src/app/components/pages/details_user/model.rs:50
msgid "Profile"
msgstr "Προφίλ"

#: src/app/components/pages/details_user/widget.rs:34
msgid "Public Playlists"
msgstr "Κοινές λίστες"

#. translators: Short text displayed instead of a track title when nothing plays
#: src/app/components/pages/now_playing/widget.rs:50
#: src/app/components/shell/playback/playback_info.rs:73
msgid "No Track Playing"
msgstr "Κανένα τρέχον τραγούδι"

#. translators: Title of the queue, listing what plays next, when it's shown beside the content.
#. Translators: Tooltip of the playback bar button that shows or hides the queue.
#: src/app/components/pages/queue/component.rs:57
#: src/app/components/shell/playback/playback_widget.blp:158
msgid "Queue"
msgstr "Ουρά"

#: src/app/components/pages/saved_albums/model.rs:109
msgid "You have no saved albums."
msgstr "Δεν έχετε αποθηκευμένους δίσκους."

#: src/app/components/pages/saved_albums/model.rs:112
msgid "Your library will be shown here."
msgstr "Η βιβλιοθήκη σας θα εμφανίζεται εδώ."

#: src/app/components/pages/saved_artists/model.rs:101
msgid "You have no saved artists."
msgstr "Δεν έχετε αποθηκευμένους καλλιτέχνες."

#: src/app/components/pages/saved_artists/model.rs:104
msgid "Your followed artists will be shown here."
msgstr "Οι καλλιτέχνες που ακολουθείτε θα εμφανίζονται εδώ."

#. translators: Filter of the saved playlists: shows all of them.
#: src/app/components/pages/saved_playlists/model.rs:105
#: src/app/models/card_enums.rs:172
msgid "All"
msgstr "Όλες"

#. translators: Filter of the saved playlists: shows only those the user created.
#: src/app/components/pages/saved_playlists/model.rs:107
msgid "Created"
msgstr "Δημιουργήθηκε"

#. translators: Filter of the saved playlists: shows only those made by others, which the user follows.
#: src/app/components/pages/saved_playlists/model.rs:109
msgid "Followed"
msgstr "Ακολουθήθηκε"

#: src/app/components/pages/saved_playlists/model.rs:128
msgid "You have no saved playlists."
msgstr "Δεν έχετε αποθηκευμένες λίστες."

#: src/app/components/pages/saved_playlists/model.rs:131
msgid "Your playlists will be shown here."
msgstr "Οι λίστες σας θα εμφανίζονται εδώ."

#: src/app/components/pages/saved_tracks/model.rs:59
msgid "All Tracks"
msgstr "Όλα τα τραγούδια"

#: src/app/components/pages/saved_tracks/model.rs:71
#, rust-format
msgid "{} Track"
msgid_plural "{} Tracks"
msgstr[0] "Τραγούδι"
msgstr[1] "Τραγούδια"

#: src/app/components/shell/clipboard_import/mod.rs:91
msgid "Open Spotify link?"
msgstr "Άνοιγμα συνδέσμου Spotify;"

#: src/app/components/shell/clipboard_import/mod.rs:95
msgid "There’s a Spotify album link in your clipboard. Open it in Riff?"
msgstr "Υπάρχει σύνδεσμος δίσκου Spotify στο πρόχειρο σας. Άνοιγμα στο Riff;"

#: src/app/components/shell/clipboard_import/mod.rs:99
msgid "There’s a Spotify artist link in your clipboard. Open it in Riff?"
msgstr ""
"Υπάρχει σύνδεσμος καλλιτέχνη Spotify στο πρόχειρο σας. Άνοιγμα στο Riff;"

#: src/app/components/shell/clipboard_import/mod.rs:103
msgid "There’s a Spotify playlist link in your clipboard. Open it in Riff?"
msgstr "Υπάρχει σύνδεσμος λίστας Spotify στο πρόχειρο σας. Άνοιγμα στο Riff;"

#: src/app/components/shell/clipboard_import/mod.rs:107
msgid "There’s a Spotify profile link in your clipboard. Open it in Riff?"
msgstr "Υπάρχει σύνδεσμος προφίλ Spotify στο πρόχειρο σας. Άνοιγμα στο Riff;"

#: src/app/components/shell/clipboard_import/mod.rs:111
msgid "There’s a Spotify track link in your clipboard. Open it in Riff?"
msgstr ""
"Υπάρχει σύνδεσμος τραγουδιού Spotify στο πρόχειρο σας. Άνοιγμα στο Riff;"

#. translators: Button of the dialog asking to confirm clearing the play queue: keeps the queue.
#. Translators: Button label. Exits selection mode.
#. translators: Button of a dialog asking to confirm something that cannot be undone: leaves things as they are.
#: src/app/components/shell/clipboard_import/mod.rs:116
#: src/app/components/widgets/queue_list/model.rs:263
#: src/app/components/pages/queue/queue_page.blp:19
#: src/app/components/shell/headerbar/headerbar.blp:116
#: src/app/components/shell/utility_panel/utility_panel.blp:52
#: src/app/components/utils.rs:226
msgid "Cancel"
msgstr "Ακύρωση"

#: src/app/components/shell/clipboard_import/mod.rs:117
msgid "Open"
msgstr "Άνοιγμα"

#: src/app/components/shell/device_selector/widget.rs:141
#: src/app/components/shell/device_selector/device_selector.blp:9
#: src/app/components/shell/device_selector/device_selector.blp:37
msgid "This Device"
msgstr "Αυτή η συσκευή"

#. translators: This is a navigation panel entry to browse to saved albums.
#: src/app/components/shell/navigation/factory.rs:55
#: src/app/components/shell/navigation_panel/navigation_panel_item.rs:76
#: src/app/components/shell/navigation_panel/navigation_panel_item.rs:148
msgid "Library"
msgstr "Βιβλιοθήκη"

#. translators: This is a navigation panel entry that marks that the entries below are playlists.
#: src/app/components/shell/navigation/factory.rs:71
#: src/app/components/shell/navigation_panel/navigation_panel_item.rs:82
#: src/app/components/pages/shortcuts/shortcuts.blp:94
msgid "Playlists"
msgstr "Λίστες"

#. translators: This is a navigation panel entry to browse to followed artists.
#: src/app/components/shell/navigation/factory.rs:82
#: src/app/components/shell/navigation_panel/navigation_panel_item.rs:84
#: src/app/components/pages/shortcuts/shortcuts.blp:84
msgid "Artists"
msgstr "Καλλιτέχνες"

#. translators: Shown in a toast after closing settings when a changed setting needs an app restart.
#: src/app/components/shell/notification/mod.rs:93
msgid "Please restart the app to apply the changes"
msgstr "Παρακαλώ επανεκκινήστε την εφαρμογή για ολοκλήρωση των αλλαγών"

#. translators: Button in the toast that restarts the app to apply changed settings.
#: src/app/components/shell/notification/mod.rs:95
msgid "Restart"
msgstr "Επανεκκίνηση"

#: src/app/components/shell/notification/mod.rs:111
msgid "Connection lost. Trying to reconnect…"
msgstr "Χάθηκε η σύνδεση. Προσπάθεια επανασύνδεσης…"

#. translators: Shown in a toast when the user presses Previous but there is no earlier track to play.
#: src/app/components/shell/notification/mod.rs:137
msgid "No previous track"
msgstr "Δεν υπάρχει προηγούμενο τραγούδι"

#: src/app/components/shell/playback/playback_controls.rs:69
#: src/app/components/widgets/details_page/header.rs:231
msgid "Pause"
msgstr "Παύση"

#: src/app/components/shell/navigation_panel/model.rs:87
msgid "Unnamed Playlist"
msgstr "Ανώνυμη λίστα"

#: src/app/components/shell/navigation_panel/model.rs:439
msgid "Pinned Playlist"
msgstr "Καρφιτσωμένη λίστα"

#: src/app/components/shell/navigation_panel/model.rs:440
msgid "Pinned Album"
msgstr "Καρφιτσωμένος δίσκος"

